#pragma once

// Copy this file to secrets.h (secrets.h is gitignored) and fill in real values.

#define WIFI_SSID     "YOUR_WIFI_NAME"
#define WIFI_PASS     "YOUR_WIFI_PASSWORD"

// From the SinricPro portal (sinric.pro) -> Credentials
#define APP_KEY       "YOUR_SINRIC_PRO_APP_KEY"
#define APP_SECRET    "YOUR_SINRIC_PRO_APP_SECRET"

// Device IDs from the SinricPro portal -> Devices -> (each device) -> Device ID
#define FAN_ID        "YOUR_SINRIC_PRO_FAN_DEVICE_ID"     // Fan (US) device, 3 speeds
#define LIGHT_ID      "YOUR_SINRIC_PRO_LIGHT_DEVICE_ID"   // Switch device
#define FAN2_ID       "YOUR_SINRIC_PRO_FAN2_DEVICE_ID"    // 2nd Fan (US) device, no light

// Positions of the 4 DIP switches on this fan's remote (the little sliders
// under the battery cover, not anything on this board). They set the RF
// address the remote sends -- get them right or this will end up sending
// commands to a different fan on the same frequency/protocol. true = ON.
#define DIP_SWITCH_1  false
#define DIP_SWITCH_2  false
#define DIP_SWITCH_3  false
#define DIP_SWITCH_4  false

// ==========================================
// Fan 2 -- second physical fan, its own remote
// ==========================================
// Which remote family fan 2 uses. REMOTE_TR313A is the same DIP-switch-
// addressed family as fan 1 above (a second fan on that remote family);
// REMOTE_SST12 is a NOMA remote that pairs directly to the fan's receiver
// (no DIP switches, one fixed code per button, set at boot from the
// FAN2_RF_CODE_* values below instead of a DIP address).
#define FAN2_REMOTE_TYPE REMOTE_SST12

// Only used if FAN2_REMOTE_TYPE is REMOTE_TR313A -- same meaning as
// DIP_SWITCH_1..4 above, but for fan 2's remote.
#define FAN2_DIP_SWITCH_1  false
#define FAN2_DIP_SWITCH_2  false
#define FAN2_DIP_SWITCH_3  false
#define FAN2_DIP_SWITCH_4  false

// Only used if FAN2_REMOTE_TYPE is REMOTE_SST12 -- capture these with
// sniff.ino (env:c3_mini) by pressing each button on the SST12 remote and
// reading off the decimal code it prints. There's no separate fan-off
// button pairing needed beyond this: whichever button on the remote turns
// the fan off is FAN2_RF_CODE_OFF, same idea for low/medium/high.
#define FAN2_RF_CODE_LOW     0
#define FAN2_RF_CODE_MEDIUM  0
#define FAN2_RF_CODE_HIGH    0
#define FAN2_RF_CODE_OFF     0

// ntfy.sh topic for reboot notifications. Pick something random/unguessable
// (ntfy topics are unauthenticated by default) and subscribe to it in the
// ntfy app (iOS/Android) to receive the pushes.
#define NTFY_TOPIC    "YOUR_RANDOM_NTFY_TOPIC"
